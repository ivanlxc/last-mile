* text=auto
*.sh text eol=lf
*.command text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.blend binary
*.glb binary
*.fbx binary
*.task binary
*.png binary
*.jpg binary
*.pdf binary
*.zip binary
# Unity serializes empty YAML fields with a trailing space.
unity/**/*.meta whitespace=-blank-at-eol
unity/**/*.asset whitespace=-blank-at-eol
unity/**/*.mat whitespace=-blank-at-eol
unity/**/*.unity whitespace=-blank-at-eol
