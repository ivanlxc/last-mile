      "harmony": "E suspended"
    },
    {
      "name": "The responsibility rises",
      "startBeat": 32,
      "endBeat": 44,
      "harmony": "D minor/add9, D minor, D minor/11"
    },
    {
      "name": "Quiet weight at the crest",
      "startBeat": 44,
      "endBeat": 48,
      "harmony": "D minor"
    },
    {
      "name": "Across, still unresolved",
      "startBeat": 48,
      "endBeat": 64,
      "harmony": "E suspended, with the fourth held through withdrawal"
    }
  ],
