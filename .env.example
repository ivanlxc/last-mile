# Copy this template to .env in the project root. Only edit .env with real keys.
# .env is ignored by Git; .env.example is a public, empty template.
# Choose ONE provider: offline | openai | anthropic.
MODEL_PROVIDER=offline

# OpenAI: set MODEL_PROVIDER=openai and fill BOTH fields below.
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic: set MODEL_PROVIDER=anthropic and fill BOTH fields below.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional English voice input and read aloud. Never use a VITE_ prefix for this key.
# Without a key the game remains fully playable with text.
DEEPGRAM_API_KEY=
# DEEPGRAM_ENABLED=false
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Optional OpenAI reasoning effort; omit for models that do not support it.
# gpt-5.6-luna: low passed the local integration smoke test (2026-09-16).
# OPENAI_REASONING_EFFORT=low
# Optional bounded runtime limits. Without these, defaults are 8000/20000 ms
# and 1200/3000 output tokens. Tested Luna playtest settings:
# AI_ADVISOR_TIMEOUT_MS=30000
# AI_EVALUATOR_TIMEOUT_MS=45000
# AI_ADVISOR_MAX_OUTPUT_TOKENS=2500
# AI_EVALUATOR_MAX_OUTPUT_TOKENS=5000

# Save .env and restart the backend for any change to take effect.
# Clicking the launcher while the old server is running will NOT restart it.
PORT=3111
# Local mode listens on loopback. For Render, use deploy/render.env.example.
LAST_MILE_MODE=local
# LAST_MILE_DB=.last-mile/game.sqlite
