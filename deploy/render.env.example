# Public empty template, NOT a location for real secrets.
# Enter real values only in Render > Environment, or an ignored local .env file.
NODE_VERSION=24
NODE_ENV=production
LAST_MILE_MODE=cloud

# Neon DIRECT connection string. Turn OFF connection pooling in Neon's Connect dialog.
# Keep TLS enabled. Never paste the connection string into chat or commit it.
DATABASE_URL=

# Render's Generate button can generate both values. They serve different purposes.
# Share ONLY the invite code with your playtesters (at least 16 characters).
LAST_MILE_INVITE_CODE=
# Keep this secret stable between deploys (at least 32 characters).
LAST_MILE_COOKIE_SECRET=

# Render provides RENDER_EXTERNAL_URL automatically. Only set this for a custom domain.
# LAST_MILE_PUBLIC_ORIGIN=https://your-exact-game-domain.example

MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
AI_ADVISOR_TIMEOUT_MS=30000
AI_EVALUATOR_TIMEOUT_MS=45000
AI_ADVISOR_MAX_OUTPUT_TOKENS=2500
AI_EVALUATOR_MAX_OUTPUT_TOKENS=5000

LAST_MILE_MAX_ACTIVE_SESSIONS=5
LAST_MILE_MAX_SESSIONS_PER_PLAYER_PER_DAY=3
AI_MAX_DAILY_ATTEMPTS=100
AI_MAX_CONCURRENT_JOBS=2

# Optional English voice input and read aloud (server secret only).
DEEPGRAM_API_KEY=
# DEEPGRAM_ENABLED=false
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Do not set PORT or LAST_MILE_DB here: Render supplies PORT and cloud uses PostgreSQL.
