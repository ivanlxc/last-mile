<mxfile host="app.diagrams.net" version="31.4.5" type="device"><diagram id="02_Containers" name="02_Containers"><mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1090" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="02 / Containers and deployment" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#172d45;fontSize=24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1500" height="48" as="geometry" /></mxCell><mxCell id="subtitle" value="A modular monolith for the hackathon; separate security capabilities, no unnecessary microservices" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#172d45;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="75" width="1500" height="42" as="geometry" /></mxCell><mxCell id="browser" value="BROWSER / COMMANDER UI&#10;React + Three.js map + 2D scene panels&#10;Command queue / SSE / derived view state" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#3569ad;fontColor=#172d45;fontSize=20;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="160" width="440" height="180" as="geometry" /></mxCell><mxCell id="http" value="LOCAL BACKEND / NODE + FASTIFY&#10;Command API + Projection API&#10;Auth, validation, per-session coordinator" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9f5ee;strokeColor=#2d8058;fontColor=#172d45;fontSize=20;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="630" y="160" width="460" height="180" as="geometry" /></mxCell><mxCell id="worker" value="ASYNC WORKERS / SAME PROCESS&#10;Scheduler + Advisor + Evaluator&#10;Durable job records, bounded provider calls" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3edff;strokeColor=#7957a8;fontColor=#172d45;fontSize=19;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="630" y="470" width="460" height="180" as="geometry" /></mxCell><mxCell id="sqlite" value="LOCAL SQLITE&#10;WAL / FK / one session writer&#10;Events, ledgers, snapshots, jobs" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f0f3f7;strokeColor=#64748b;fontColor=#172d45;fontSize=19;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="470" width="380" height="180" as="geometry" /></mxCell><mxCell id="private" value="PRIVATE FILE REGISTRY&#10;Scenario variants + policy + truth&#10;Never included in public build" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3df;strokeColor=#ae7223;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1150" y="470" width="355" height="180" as="geometry" /></mxCell><mxCell id="public" value="PUBLIC STATIC ASSETS&#10;GLB / 2D scene art / map topology&#10;No case-specific file names" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#3569ad;fontColor=#172d45;fontSize=19;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="800" width="440" height="150" as="geometry" /></mxCell><mxCell id="provider" value="EXTERNAL MODEL PROVIDER&#10;Secret held by backend&#10;Advisor and Evaluator contexts isolated" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3edff;strokeColor=#7957a8;fontColor=#172d45;fontSize=19;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1025" y="800" width="480" height="150" as="geometry" /></mxCell><mxCell id="e1" value="Same-origin JSON / SSE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" par