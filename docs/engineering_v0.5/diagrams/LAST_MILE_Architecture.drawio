" y="555" /></Array></mxGeometry></mxCell><mxCell id="e5" value="Same scene" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="wait" target="scene"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="e6" value="N07 or deadline" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="travel" target="arrive"><mxGeometry relative="1" y="-14" as="geometry"><Array as="points"><mxPoint x="750" y="230" /><mxPoint x="750" y="685" /><mxPoint x="300" y="685" /></Array></mxGeometry></mxCell><mxCell id="e7" value="Deadline / abandon" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.75;entryY=0;" edge="1" parent="1" source="scene" target="arrive"><mxGeometry relative="1" y="-14" as="geometry"><Array as="points"><mxPoint x="1390" y="230" /><mxPoint x="1390" y="730" /><mxPoint x="430" y="730" /></Array></mxGeometry></mxCell><mxCell id="e8" value="Seal hash" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="arrive" target="eval"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="ops" value="OPERATION LIFECYCLE&#10;accepted -&gt; running -&gt; completed&#10;                  |-&gt; cancelled (leave / terminal)&#10;                  |-&gt; failed (technical)&#10;Only accepted/running are active." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f0f3f7;strokeColor=#64748b;fontColor=#172d45;fontSize=19;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="465" width="565" height="180" as="geometry" /></mxCell><mxCell id="note" value="Recovery after bridge refusal: remain in E3; allow one ford decision or WAIT. No hidden teleport, no scene quota refill.&#10;Server restart seals an interrupted run; browser refresh only reconnects. Exact ordering is in the runtime LLD." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#172d45;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="955" width="1380" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>