="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#172d45;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="75" width="1480" height="42" as="geometry" /></mxCell><mxCell id="w" value="W / WORLD AUTHORITY&#10;WorldEngine + private scenario&#10;Facts, authored outcomes, original roots" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3df;strokeColor=#ae7223;fontColor=#172d45;fontSize=20;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="35" y="160" width="390" height="190" as="geometry" /></mxCell><mxCell id="r" value="R / ROLE INVENTORIES&#10;Analyst + Liaison (NPC)&#10;Acquired evidence, private observations" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9f5ee;strokeColor=#2d8058;fontColor=#172d45;fontSize=20;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="575" y="160" width="390" height="190" as="geometry" /></mxCell><mxCell id="c" value="C / COMMANDER PROJECTION&#10;Reports &lt;= 3 per role / scene&#10;Time, health, channel balances" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#3569ad;fontColor=#172d45;fontSize=20;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1115" y="160" width="390" height="190" as="geometry" /></mxCell><mxCell id="a" value="A / ADVISOR INPUT&#10;Uploaded cards &lt;= 5 / scene&#10;Approved background + map + statements" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3edff;strokeColor=#7957a8;fontColor=#172d45;fontSize=20;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1115" y="530" width="390" height="200" as="geometry" /></mxCell><mxCell id="eval" value="POSTGAME EVALUATOR&#10;Sealed behavior facts + cited events&#10;No live-world mutation capability" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3edff;strokeColor=#7957a8;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="575" y="760" width="390" height="160" as="geometry" /></mxCell><mxCell id="fact" value="DETERMINISTIC FACT BUILDER&#10;Visible-at-decision snapshots&#10;Truth comparison kept in separate section" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3df;strokeColor=#ae7223;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="35" y="740" width="390" height="180" as="geometry" /></mxCell><mxCell id="e1" value="1. Paid investigation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="w" target="r"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="e2" value="2. New immutable report" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r" target="c"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="e3" value="3. Explicit upload / question" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c" target="a"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="e4" value="4. Validated advice" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="a" target="c"><mxGeometry relative="1" y="-14" as="geometry"><Array as="points"><mxPoint x="1530" y="630" /><mxPoint x="1530" y="260" /></Array></mxGeometry></mxCell><mxCell id="e5" value="Seal + truth" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="w" target="fact"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="e6" value="Decision snapshots" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c" target="fact"><mxGeometry relative="1" y="-14" as="geometry"><Array as="points"><mxPoint x="1050" y="405" /><mxPoint x="465" y="405" /><mxPoint x="465" y="650" /><mxPoint x="230" y="650" /></Array></mxGeometry></mxCell><mxCell id="e7" value="Measured facts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="fact" target="eval"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="legend" value="DENIED PATHS&#10;World -&gt; browser or Advisor: forbidden&#10;Commander private HUD -&gt; Advisor: not automatic&#10;Advisor -&gt; actions / quota writes: forbidden&#10;Provenance roots -&gt; UI: only after disclosure" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffecec;strokeColor=#b65454;fontColor=#172d45;fontSize=17;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="575" y="455" width="450" height="240" as="geometry" /></mxCell><mxCell id="note" value="The single-player NPC selection policy is deterministic and topic-based. It cannot use hidden truth to choose the most useful clue.&#10;AI-unseen panel is computed from C minus A in the UI; it is never supplied to the model." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#172d45;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="35" y="940" width="1470" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="04_Command_Sequence" name="04_Command_Sequence"><mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="1110" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="04 / Investigation, report and upload" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#172d45;fontSize=24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1480" height="48" as="geometry" /></mxCell><mxCell id="subtitle" value="Two roles may investigate concurrently; all changes commit through one session writer" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#172d45;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="75" width="1480" height="42" as="geometry" /></mxCell><mxCell id="u" value="UI / PLAYER" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#3569ad;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="145" width="310" height="65" as="geometry" /></mxCell><mxCell id="api" value="SESSION COORDINATOR" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9f5ee;strokeColor=#2d8058;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="425" y="145" width="310" height="65" as="geometry" /></mxCell><mxCell id="world" value="NPC + WORLD" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3df;strokeColor=#ae7223;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="805" y="145" width="310" height="65" as="geometry" /></mxCell><mxCell id="db" value="SQLITE + JOBS" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3edff;strokeColor=#7957a8;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1185" y="145" width="310" height="65" as="geometry" /></mxCell><mxCell id="s1" value="1  Submit task&#10;expected version + idempotency key" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#3569ad;fontColor=#172d45;fontSize=17;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="270" width="310" height="140" as="geometry" /></mxCell><mxCell id="s2" value="2  Catch up due events&#10;Commit before command validation" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9f5ee;strokeColor=#2d8058;fontColor=#172d45;fontSize=17;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="425" y="270" width="310" height="140" as="geometry" /></mxCell><mxCell id="s3" value="3  Validate role / target / quotas&#10;Reserve report; consume channel" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3df;strokeColor=#ae7223;fontColor=#172d45;fontSize=17;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="805" y="270" width="310" height="140" as="geometry" /></mxCell><mxCell id="s4" value="4  Commit task + ledger + event&#10;Return 202 and operation ID" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3edff;strokeColor=#7957a8;fontColor=#172d45;fontSize=17;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1185" y="270" width="310" height="140" as="geometry" /></mxCell><mxCell id="s5" value="5  Scheduler reaches due time&#10;Resolve authored observation" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3df;strokeColor=#ae7223;fontColor=#172d45;fontSize=17;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="805" y="485" width="310" height="140" as="geometry" /></mxCell><mxCell id="s6" value="6  Commit immutable evidence&#10;Consume reserved report slot&#10;Persist report + public event" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3edff;strokeColor=#7957a8;fontColor=#172d45;fontSize=17;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1185" y="485" width="310" height="140" as="geometry" /></mxCell><mxCell id="s7" value="7  Read new report via SSE&#10;Choose whether to upload it" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#3569ad;fontColor=#172d45;fontSize=17;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="700" width="310" height="140" as="geometry" /></mxCell><mxCell id="s8" value="8  Validate report ownership&#10;Consume NEW upload slot" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9f5ee;strokeColor=#2d8058;fontColor=#172d45;fontSize=17;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="425" y="700" width="310" height="140" as="geometry" /></mxCell><mxCell id="s9" value="9  Commit input manifest + job&#10;Model call occurs after commit" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3edff;strokeColor=#7957a8;fontColor=#172d45;fontSize=17;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1185" y="700" width="310" height="140" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSi