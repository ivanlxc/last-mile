x="1090" y="280" width="300" height="210" as="geometry" /></mxCell><mxCell id="author" value="CONTENT AUTHOR&#10;Versioned scenarios + public map&#10;Approved background registry" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3df;strokeColor=#ae7223;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="520" y="610" width="420" height="150" as="geometry" /></mxCell><mxCell id="e1" value="Local UI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="human" target="game"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="e2" value="HTTPS / bounded JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="game" target="model"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="e3" value="Validate + publish offline" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="author" target="game"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="note" value="Boundary: browser never receives the private scenario. No automatic transfer of private HUD data to Advisor; hidden source roots stay private.&#10;Evaluator starts only after the session is sealed; it cannot change the outcome." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#172d45;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="45" y="800" width="1350" height="65" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="02_Containers" name="02_Containers"><mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1090" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="02 / Containers and deployment" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#172d45;fontSize=24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1500" height="48" as="geometry" /></mxCell><mxCell id="subtitle" value="A modular monolith for the hackathon; separate security capabilities, no unnecessary microservices" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#172d45;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="75" width="1500" height="42" as="geometry" /></mxCell><mxCell id="browser" value="BROWSER / COMMANDER UI&#10;React + Three.js map + 2D scene panels&#10;Command queue / SSE / derived view state" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#3569ad;fontColor=#172d45;fontSize=20;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="160" width="440" height="180" as="geometry" /></mxCell><mxCell id="http" value="LOCAL BACKEND / NODE + FASTIFY&#10;Command API + Projection API&#10;Auth, validation, per-session coordinator" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9f5ee;strokeColor=#2d8058;fontColor=#172d45;fontSize=20;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="630" y="160" width="460" height="180" as="geometry" /></mxCell><mxCell id="worker" value="ASYNC WORKERS / SAME PROCESS&#10;Scheduler + Advisor + Evaluator&#10;Durable job records, bounded provider calls" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3edff;strokeColor=#7957a8;fontColor=#172d45;fontSize=19;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="630" y="470" width="460" height="180" as="geometry" /></mxCell><mxCell id="sqlite" value="LOCAL SQLITE&#10;WAL / FK / one session writer&#10;Events, ledgers, snapshots, jobs" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f0f3f7;strokeColor=#64748b;fontColor=#172d45;fontSize=19;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="470" width="380" height="180" as="geometry" /></mxCell><mxCell id="private" value="PRIVATE FILE REGISTRY&#10;Scenario variants + policy + truth&#10;Never included in public build" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3df;strokeColor=#ae7223;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1150" y="470" width="355" height="180" as="geometry" /></mxCell><mxCell id="public" value="PUBLIC STATIC ASSETS&#10;GLB / 2D scene art / map topology&#10;No case-specific file names" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#3569ad;fontColor=#172d45;fontSize=19;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="800" width="440" height="150" as="geometry" /></mxCell><mxCell id="provider" value="EXTERNAL MODEL PROVIDER&#10;Secret held by backend&#10;Advisor and Evaluator contexts isolated" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3edff;strokeColor=#7957a8;fontColor=#172d45;fontSize=19;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1025" y="800" width="480" height="150" as="geometry" /></mxCell><mxCell id="e1" value="Same-origin JSON / SSE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="browser" target="http"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="e2" value="After-commit work" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="http" target="worker"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="e3" value="Atomic transactions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="http" target="sqlite"><mxGeometry relative="1" y="-14" as="geometry"><Array as="points"><mxPoint x="570" y="385" /><mxPoint x="270" y="385" /></Array></mxGeometry></mxCell><mxCell id="e4" value="Claim / persist" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="worker" target="sqlite"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="e5" value="Validated content" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="private" target="http"><mxGeometry relative="1" y="-14" as="geometry"><Array as="points"><mxPoint x="1325" y="395" /><mxPoint x="860" y="395" /></Array></mxGeometry></mxCell><mxCell id="e6" value="TLS / typed JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;