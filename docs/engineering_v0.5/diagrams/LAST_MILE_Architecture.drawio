><mxPoint x="960" y="450" /></Array></mxGeometry></mxCell><mxCell id="e7" value="Public projection only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" y="-14" as="geometry"><Array as="points"><mxPoint x="1340" y="640" /><mxPoint x="200" y="640" /></Array></mxGeometry></mxCell><mxCell id="e8" value="Atomic command" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s8" target="s9"><mxGeometry relative="1" y="-14" as="geometry"><Array as="points"><mxPoint x="580" y="900" /><mxPoint x="1340" y="900" /></Array></mxGeometry></mxCell><mxCell id="note" value="RETRY / FAILURE RULES&#10;Same key + same body returns the recorded result. Same key + changed body returns 409.&#10;Leaving a scene cancels unfinished investigations: release report reservation, keep spent channel cost.&#10;A technical failure uses a compensating ledger entry. A correction never mutates an old report or upload." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f0f3f7;strokeColor=#64748b;fontColor=#172d45;fontSize=17;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="955" width="1450" height="135" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="05_Advisor_Sequence" name="05_Advisor_Sequence"><mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="05 / Advisor orchestration" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#172d45;fontSize=24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1380" height="48" as="geometry" /></mxCell><mxCell id="subtitle" value="Bounded inference; immutable input manifests; stale answers cannot replace current advice" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#172d45;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="75" width="1380" height="42" as="geometry" /></mxCell><mxCell id="trigger" value="1 / Trigger&#10;Scene entry, upload, explicit question" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#3569ad;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="55" y="170" width="400" height="120" as="geometry" /></mxCell><mxCell id="input" value="2 / Build allowed context&#10;Only projection A; hash + contextVersion" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9f5ee;strokeColor=#2d8058;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="535" y="170" width="400" height="120" as="geometry" /></mxCell><mxCell id="persist" value="3 / Persist manifest and job&#10;Debounce uploads; bounded queue" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f0f3f7;strokeColor=#64748b;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1015" y="170" width="370" height="120" as="geometry" /></mxCell><mxCell id="call" value="4 / ModelAdapter.generate()&#10;Read-only scoped tools; timeout budget" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3edff;strokeColor=#7957a8;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1015" y="460" width="370" height="140" as="geometry" /></mxCell><mxCell id="guard" value="5 / Validate schema + references&#10;Check citations, action IDs and claims" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9f5ee;strokeColor=#2d8058;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="535" y="460" width="400" height="140" as="geometry" /></mxCell><mxCell id="publish" value="6 / Compare epoch + context version&#10;Publish current result or mark superseded" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#3569ad;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="55" y="460" width="400" height="140" as="geometry" /></mxCell><mxCell id="fallback" value="DEGRADED MODE&#10;Label offline template explicitly&#10;Never claim a model call succeeded" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3df;strokeColor=#ae7223;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1015" y="805" width="370" height="130" as="geometry" /></mxCell><mxCell id="audit" value="AUDIT RECORD&#10;Model version / prompt hash / input IDs&#10;Attempts / latency / token usage / mode" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f0f3f7;strokeColor=#64748b;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="535" y="805" width="400" height="130" as="geometry" /></mxCell><mxCell id="display" value="DISPLAY RECEIPT&#10;Record advice actually rendered&#10;Used by evaluation, never inferred" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#3569ad;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="55" y="805" width="400" height="130" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="trigger" target="input"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="input" target="persist"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="persist" target="call"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="call" target="guard"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="guard" target="publish"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="publish" target="display"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="call" target="fallback"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="fallback" target="audit"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="display" target="audit"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="note" value="No world tools. No action execution. Questions and evidence are untrusted data.&#10;Timeout / invalid output / provider unavailable =&gt; explicit degraded response; the game remains playable." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#172d45;fontSize=17;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="55" y="985" width="1330" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="06_Evaluation" name="06_Evaluation"><mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1470" pageHeight="1070" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="06 / Postgame evaluation" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#172d45;fontSize=24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1410" height="48" as="geometry" /></mxCell><mxCell id="subtitle" value="Outcome quality and trust calibration are separate; missing observations reduce confidence" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#172d45;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="75" width="1410" height="42" as="geometry" /></mxCell><mxCell id="seal" value="1 / TERMINAL SEAL&#10;Stop gameplay writes&#10;Freeze event range + decision snapshots" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f0f3f7;strokeColor=#64748b;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="400" height="140" as="geometry" /></mxCell><mxCell id="facts" value="2 / FACT BUILDER&#10;Eligibility + denominators + exclusions&#10;Fact IDs tied to observed events" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9f5ee;strokeColor=#2d8058;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="535" y="170" width="400" height="140" as="geometry" /></mxCell><mxCell id="eval" value="3 / EVALUATOR MODEL&#10;Explain supplied behavior facts&#10;Cannot alter measured scores" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3edff;strokeColor=#7957a8;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="170" width="400" height="140" as="geometry" /></mxCell><mxCell id="guard" value="4 / OUTPUT GUARD&#10;References exist; numbers match&#10;No invented motives / diagnoses" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9f5ee;strokeColor=#2d8058;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="505" width="400" height="140" as="geometry" /></mxCell><mxCell id="report" value="5 / AAR REPORT&#10;Behavior profile + confidence + next step&#10;Separate authored outcome explanation" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#3569ad;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="535" y="505" width="400" height="140" as="geometry" /></mxCell><mxCell id="fallback" value="DETERMINISTIC FALLBACK&#10;Fact table + templated feedback&#10;Label model unavailable" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3df;strokeColor=#ae7223;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="820" width="400" height="140" as="geometry" /></mxCell><mxCell id="review" value="REPLAY&#10;What player saw / what AI saw&#10;What was chosen / what happened" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#3569ad;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="505" width="400" height="140" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="seal" target="facts"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="facts" target="eval"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArr