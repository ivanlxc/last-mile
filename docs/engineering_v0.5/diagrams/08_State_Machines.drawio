<mxfile host="app.diagrams.net" version="31.4.5" type="device"><diagram id="08_State_Machines" name="08_State_Machines"><mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1510" pageHeight="1030" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="08 / Session and operation state" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#172d45;fontSize=24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1450" height="48" as="geometry" /></mxCell><mxCell id="subtitle" value="WAIT is an operation inside a scene. It never advances the scene or resets quotas." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#172d45;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="75" width="1450" height="42" as="geometry" /></mxCell><mxCell id="ready" value="READY&#10;Policy / content pinned" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f0f3f7;strokeColor=#64748b;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="270" height="105" as="geometry" /></mxCell><mxCell id="travel" value="TRAVELLING&#10;Server scheduled segments" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#3569ad;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="180" width="300" height="105" as="geometry" /></mxCell><mxCell id="scene" value="DECISION SCENE&#10;Investigate / report / upload / ask" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9f5ee;strokeColor=#2d8058;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="835" y="180" width="350" height="105" as="geometry" /></mxCell><mxCell id="wait" value="WAIT 