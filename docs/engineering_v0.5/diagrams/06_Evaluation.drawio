<mxfile host="app.diagrams.net" version="31.4.5" type="device"><diagram id="06_Evaluation" name="06_Evaluation"><mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1470" pageHeight="1070" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="06 / Postgame evaluation" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#172d45;fontSize=24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1410" height="48" as="geometry" /></mxCell><mxCell id="subtitle" value="Outcome quality and trust calibration are separate; missing observations reduce confidence" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#172d45;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="75" width="1410" height="42" as="geometry" /></mxCell><mxCell id="seal" value="1 / TERMINAL SEAL&#10;Stop gameplay writes&#10;Freeze event range + decision snapshots" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f0f3f7;strokeColor=#64748b;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="400" height="140" as="geometry" /></mxCell><mxCell id="facts" value="2 / FACT BUILDER&#10;Eligibility + denominators + exclusions&#10;Fact IDs tied to observed events" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9f5ee;strokeColor=#2d8058;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="535" y="170" width="400" height="140" as="geometry" /></mxCell><mxCell id="eval" value="3 / EVALUATOR MODEL&#10;Explain supplied behavior facts&#10;Cannot alter measured scores" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3edff;strokeColor=#7957a8;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="170" width="400" height="140" as="geometry" /></mxCell><mxCell id="guard" value="4 / OUTPUT GUARD&#10;References exist; numbers match&#10;No invented motives / diagnoses" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9f5ee;strokeColor=#2d8058;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="505" width="400" height="140" as="geometry" /></mxCell><mxCell id="report" value="5 / AAR REPORT&#10;Behavior profile + confidence + next step&#10;Separate authored outcome explanation" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#3569ad;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="535" y="505" width="400" height="140" as="geometry" /></mxCell><mxCell id="fallback" value="DETERMINISTIC FALLBACK&#10;Fact table + templated feedback&#10;Label model unavailable" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3df;strokeColor=#ae7223;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="820" width="400" height="140" as="geometry" /></mxCell><mxCell id="review" value="REPLAY&#10;What player saw / what AI saw&#10;What was chosen / what happened" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#3569ad;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="505" width="400" height="140" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="seal" target="facts"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="facts" target="eval"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="eval" target="guard"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="guard" target="report"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="report" target="review"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="guard" target="fallback"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="note" value="Four dimensions: complacency / distrust / over-caution / calibrated trust.&#10;A correct action alone is not proof of calibrated trust. A bad outcome alone is not proof of misuse.&#10;NPC omissions, unseen advice, technical failures and interrupted sessions require explicit exclusions." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f0f3f7;strokeColor=#64748b;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="795" width="895" height="180" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>