<mxfile host="app.diagrams.net" version="31.4.5" type="device"><diagram id="04_Command_Sequence" name="04_Command_Sequence"><mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="1110" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="04 / Investigation, report and upload" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#172d45;fontSize=24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1480" height="48" as="geometry" /></mxCell><mxCell id="subtitle" value="Two roles may investigate concurrently; all changes commit through one session writer" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#172d45;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="75" width="1480" height="42" as="geometry" /></mxCell><mxCell id="u" value="UI / PLAYER" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#3569ad;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="145" width="310" height="65" as="geometry" /></mxCell><mxCell id="api" value="SESSION COORDINATOR" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9f5ee;strokeColor=#2d8058;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="425" y="145" width="310" height="65" as="geometry" /></mxCell><mxCell id="world" value="NPC + WORLD" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3df;strokeColor=#ae7223;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="805" y="145" width="310" height="65" as="geometry" /></mxCell><mxCell id="db" value="SQLITE + JOBS" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3edff;strokeColor=#7957a8;fontColor=#172d45;fontSize=18;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1185" y="145" width="310" height="65" as="geometry" /></mxCell><mxCell id="s1" value="1  Submit task&#10;expected version + idempotency key" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#3569ad;fontColor=#172d45;fontSize=17;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="270" width="310" height="140" as="geometry" /></mxCell><mxCell id="s2" value="2  Catch up due events&#10;Commit before command validation" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9f5ee;strokeColor=#2d8058;fontColor=#172d45;fontSize=17;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="425" y="270" width="310" height="140" as="geometry" /></mxCell><mxCell id="s3" value="3  Validate role / target / quotas&#10;Reserve report; consume channel" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3df;strokeColor=#ae7223;fontColor=#172d45;fontSize=17;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="805" y="270" width="310" height="140" as="geometry" /></mxCell><mxCell id="s4" value="4  Commit task + ledger + event&#10;Return 202 and operation ID" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3edff;strokeColor=#7957a8;fontColor=#172d45;fontSize=17;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1185" y="270" width="310" height="140" as="geometry" /></mxCell><mxCell id="s5" value="5  Scheduler reaches due time&#10;Resolve authored observation" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3df;strokeColor=#ae7223;fontColor=#172d45;fontSize=17;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="805" y="485" width="310" height="140" as="geometry" /></mxCell><mxCell id="s6" value="6  Commit immutable evidence&#10;Consume re