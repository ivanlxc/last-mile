arget="s3"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" y="-14" as="geometry" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" y="-14" as="geometry"><Array as="points"><mxPoint x="1340" y="450" /><mxPoint x="960" y="450" /></Array></mxGeometry></mxCell><mxCell id="e7" value="Public projection only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" y="-14" as="geometry"><Array as="points"><mxPoint x="1340" y="640" /><mxPoint x="200" y="640" /></Array></mxGeometry></mxCell><mxCell id="e8" value="Atomic command" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172d45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s8" target="s9"><mxGeometry relative="1" y="-14" as="geometry"><Array as="points"><mxPoint x="580" y="900" /><mxPoint x="1340" y="900" /></Array></mxGeometry></mxCell><mxCell id="note" value="RETRY / FAILURE RULES&#10;Same key + same body returns the recorded result. Same key + changed body returns 409.&#10;Leaving a scene cancels unfinished investigations: release report reservation, keep spent channel cost.&#10;A technical failure uses a compensating ledger entry. A correction never mutates an old report or upload." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f0f3f7;strokeColor=#64748b;fontColor=#172d45;fontSize=17;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="955" width="1450" height="135" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>