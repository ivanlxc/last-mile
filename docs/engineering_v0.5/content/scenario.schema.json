{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:last-mile:scenario:0.5",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "campaignId": {
      "type": "string",
      "minLength": 1
    },
    "visibility": {
      "type": "string",
      "enum": [
        "server_only"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "review",
        "approved"
      ]
    },
    "policyProfileId": {
      "type": "string",
      "minLength": 1
    },
    "mapId": {
      "type": "string",
      "minLength": 1
    },
    "startNodeId": {
      "type": "string",
      "minLength": 1
    },
    "entrySteps": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "hold"
                ]
              },
              "nodeId": {
                "type": "string",
                "minLength": 1
              },
              "durationMs": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "kind",
              "nodeId",
              "durationMs"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "route"
                ]
              },
              "routeId": {
                "type": "string",
                "minLength": 1
              },
              "fromFraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "toFraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "kind",
              "routeId",
              "fromFraction",
              "toFraction"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "conditionalHold"
                ]
              },
              "nodeId": {
                "type": "string",
                "minLength": 1
              },
              "flag": {
                "type": "string",
                "enum": [
                  "manifestPending",
                  "inspectionPending"
                ]
              },
              "durationMs": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "kind",
              "nodeId",
              "flag",
              "durationMs"
            ]
          }
        ]
      },
      "minItems": 1
    },
    "firstSceneId": {
      "type": "string",
      "minLength": 1
    },
    "initialFlags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifestPending": {
          "type": "boolean"
        },
        "inspectionPending": {
          "type": "boolean"
        },
        "bridgeRefused": {
          "type": "boolean"
        }
      },
      "required": [
        "manifestPending",
        "inspectionPending",
        "bridgeRefused"
      ]
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sceneId": {
            "type": "string",
            "enum": [
              "E1",
              "E2",
              "E3"
            ]
          },
          "nodeId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "intro": {
            "type": "string",
            "minLength": 1
          },
          "topicIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "backgroundIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "actionIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "sceneId",
          "nodeId",
          "title",
          "intro",
          "topicIds",
          "backgroundIds",
          "actionIds"
        ]
      },
      "minItems": 1
    },
    "approvedBackgrounds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "backgroundId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "validity": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "backgroundId",
          "title",
          "text",
          "validity"
        ]
      },
      "minItems": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "privateCaseId": {
            "type": "string",
            "minLength": 1
          },
          "truth": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "gateElectronicOnline": {
                "type": "boolean"
              },
              "marketLaneOpen": {
                "type": "boolean"
              },
              "bridgeVehicleAllowed": {
                "type": "boolean"
              },
              "explosionCause": {
                "type": "string",
                "minLength": 1
              },
              "medicalFatalityAuthored": {
                "type": "boolean"
              }
            },
            "required": [
              "gateElectronicOnline",
              "marketLaneOpen",
              "bridgeVehicleAllowed",
              "explosionCause",
              "medicalFatalityAuthored"
            ]
          },
          "evidenceDefinitions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "definitionId": {
                  "type": "string",
                  "minLength": 1
                },
                "sceneId": {
                  "type": "string",
                  "enum": [
                    "E1",
                    "E2",
                    "E3"
                  ]
                },
                "sourceRole": {
                  "type": "string",
                  "enum": [
                    "analyst",
                    "liaison"
                  ]
                },
                "channel": {
                  "type": "string",
                  "enum": [
                    "satellite",
                    "drone",
                    "localAgency",
                    "witness",
                    "initial",
                    "route_observation"
                  ]
                },
                "acquisition": {
                  "type": "string",
                  "enum": [
                    "preloaded",
                    "investigation"
                  ]
                },
                "topicId": {
                  "type": "string",
                  "minLength": 1
                },
                "priority": {
                  "type": "integer",
                  "minimum": 0
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "body": {
                  "type": "string",
                  "minLength": 1
                },
                "statementKind": {
                  "type": "string",
                  "enum": [
                    "observation",
                    "testimony",
                    "provenance",
                    "correction",
                    "brief"
                  ]
                },
                "sourceLabel": {
                  "type": "string",
                  "minLength": 1
                },
                "observationScope": {
                  "type": "string",
                  "minLength": 1
                },
                "observationAgeMs": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "provenanceStatus": {
                  "type": "string",
                  "enum": [
                    "unverified",
                    "partially_verified",
                    "verified"
                  ]
                },
                "hiddenRootId": {
                  "type": "string",
                  "minLength": 1
                },
                "traceCostChannel": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "localAgency",
                    "witness",
                    null
                  ]
                },
                "traceResult": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "title": {
                          "type": "string",
                          "minLength": 1
                        },
                        "body": {
                          "type": "string",
                          "minLength": 1
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "unverified",
                            "partially_verified",
                            "verified"
                          ]
                        },
                        "rootLabel": {
                          "type": "string",
                          "minLength": 1
                        },
                        "relatedDefinitionIds": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "minItems": 1
                        }
                      },
                      "required": [
                        "title",
                        "body",
                        "status",
                        "rootLabel",
                        "relatedDefinitionIds"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "definitionId",
                "sceneId",
                "sourceRole",
                "channel",
                "acquisition",
                "topicId",
                "priority",
                "title",
                "body",
                "statementKind",
                "sourceLabel",
                "observationScope",
                "observationAgeMs",
                "provenanceStatus",
                "hiddenRootId",
                "traceCostChannel",
                "traceResult"
              ]
            },
            "minItems": 1
          },
          "actionPlans": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "actionId": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "requiredState": {
                  "type": "string",
                  "enum": [
                    "normal",
                    "normal_or_bridge_refused"
                  ]
                },
                "steps": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "hold"
                            ]
                          },
                          "nodeId": {
                            "type": "string",
                            "minLength": 1
                          },
                          "durationMs": {
                            "type": "integer",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "kind",
                          "nodeId",
                          "durationMs"
                        ]
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "route"
                            ]
                          },
                          "routeId": {
                            "type": "string",
                            "minLength": 1
                          },
                          "fromFraction": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "toFraction": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          }
                        },
                        "required": [
                          "kind",
                          "routeId",
                          "fromFraction",
                          "toFraction"
                        ]
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "conditionalHold"
                            ]
                          },
                          "nodeId": {
                            "type": "string",
                            "minLength": 1
                          },
                          "flag": {
                            "type": "string",
                            "enum": [
                              "manifestPending",
                              "inspectionPending"
                            ]
                          },
                          "durationMs": {
                            "type": "integer",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "kind",
                          "nodeId",
                          "flag",
                          "durationMs"
                        ]
                      }
                    ]
                  },
                  "minItems": 1
                },
                "nextSceneId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "endNodeId": {
                  "type": "string",
                  "minLength": 1
                },
                "effects": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "flag": {
                        "type": "string",
                        "enum": [
                          "manifestPending",
                          "inspectionPending",
                          "bridgeRefused"
                        ]
                      },
                      "value": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "flag",
                      "value"
                    ]
                  },
                  "minItems": 0
                }
              },
              "required": [
                "actionId",
                "label",
                "requiredState",
                "steps",
                "nextSceneId",
                "endNodeId",
                "effects"
              ]
            },
            "minItems": 1
          },
          "endingText": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "privateCaseId",
          "truth",
          "evidenceDefinitions",
          "actionPlans",
          "endingText"
        ]
      },
      "minItems": 1
    },
    "caseSelection": {
      "type": "string",
      "enum": [
        "uniform_server_random_pinned_at_create"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "campaignId",
    "visibility",
    "status",
    "policyProfileId",
    "mapId",
    "startNodeId",
    "entrySteps",
    "firstSceneId",
    "initialFlags",
    "scenes",
    "approvedBackgrounds",
    "cases",
    "caseSelection"
  ]
}
