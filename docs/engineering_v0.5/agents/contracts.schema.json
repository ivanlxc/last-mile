    "DimensionResult": {
      "type": "object",
      "properties": {
        "supportLevel": {
          "enum": [
            "not_assessable",
            "not_observed",
            "observed_once",
            "repeated_observation"
          ]
        },
        "eligibleOpportunities": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "supportContextRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 36,
            "format": "uuid"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        },
        "supportFactRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 36,
            "format": "uuid"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        },
        "counterevidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 36,
            "format": "uuid"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        },
        "explanation": {
          "type": "string",
          "maxLength": 900,
          "minLength": 1
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 8
        }
      },
      "required": [
        "supportLevel",
        "eligibleOpportunities",
        "supportContextRefs",
        "supportFactRefs",
        "counterevidenceRefs",
        "explanation",
        "uncertainties"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "supportLevel": {
                "const": "not_assessable"
              }
            }
          },
          "then": {
            "properties": {
              "eligibleOpportunities": {
                "const": 0
              },
              "supportContextRefs": {
                "maxItems": 0
              },
              "supportFactRefs": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "supportLevel": {
                "const": "not_observed"
              }
            }
          },
          "then": {
            "properties": {
              "eligibleOpportunities": {
                "minimum": 1
              },
              "supportContextRefs": {
                "maxItems": 0
              },
              "supportFactRefs": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "supportLevel": {
                "const": "observed_once"
              }
            }
          },
          "then": {
            "properties": {
              "eligibleOpportunities": {
                "minimum": 1
              },
              "supportContextRefs": {
                "minItems": 1,
                "maxItems": 1
              },
              "supportFactRefs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "supportLevel": {
                "const": "repeated_observation"
              }
            }
          },
          "then": {
            "properties": {
              "eligibleOpportunities": {
                "minimum": 2
              },
              "supportContextRefs": {
                "minItems": 2
              },
              "supportFactRefs": {
                "minItems": 2
              }
            }
          }
        }
      ]
    },
