      "type": "object",
      "properties": {
        "jobId": {
          "type": "string",
          "maxLength": 36,
          "format": "uuid"
        },
        "agentRole": {
          "enum": [
            "advisor",
            "evaluator"
          ]
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "fallback",
            "failed",
            "superseded",
            "cancelled"
          ]
        },
        "mode": {
          "enum": [
            "live_model",
            "offline_template"
          ]
        },
        "inputVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "createdAt": {
          "type": "string",
          "maxLength": 40,
          "format": "date-time"
        },
        "attemptCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/AdvisorOutput"
            },
            {
              "$ref": "#/$defs/EvaluatorOutput"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "code": {
                  "enum": [
                    "AGENT_INPUT_INVALID",
                    "AGENT_INPUT_TOO_LARGE",
                    "MODEL_NOT_CONFIGURED",
                    "MODEL_TIMEOUT",
                    "MODEL_TRANSPORT",
                    "MODEL_RATE_LIMIT",
                    "MODEL_INVALID_OUTPUT",
                    "MODEL_BUDGET_EXHAUSTED",
                    "CONTEXT_SUPERSEDED",
                    "SESSION_TERMINAL"
                  ]
                },
                "retryable": {
                  "type": "boolean"
                }
              },
              "required": [
                "code",
                "retryable"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "jobId",
        "agentRole",
        "status",
        "mode",
        "inputVersion",
        "createdAt",
        "attemptCount",
        "result",
        "error"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "succeeded",
                  "fallback"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "not": {
                  "type": "null"
                }
              }
            }
          },
          "else": {
            "properties": {
              "result": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "agentRole": {
                "const": "advisor"
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/AdvisorOutput"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "else": {
            "properties": {
              "result": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/EvaluatorOutput"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "fallback"
              }
            }
          },
          "then": {
            "properties": {
              "mode": {
                "const": "offline_template"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "properties": {
              "mode": {
                "const": "live_model"
              }
            }
          }
        }
      ]
    }
  }
